{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "ingest/**/*.ts",
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "services/feed/**/*.ts",
    "services/monitor/state.ts",
    "services/monitor/*.test.ts"
  ],
  "exclude": [
    "services/feed/worker.ts",
    "services/feed/worker-configuration.d.ts"
  ]
}
