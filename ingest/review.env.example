# Non-secret example only. Copy the appropriate section into each external file.
# Changing defaults in code does not replace existing explicit environment values.

# ~/.config/prompix/editorial.env
PROMPIX_EDITORIAL_PROVIDER=codex
PROMPIX_EDITORIAL_MAX_REQUESTS=4
PROMPIX_VISUAL_PROVIDER=codex
PROMPIX_VISUAL_MAX_REQUESTS=4
# Optional: use spare review slots to classify published visuals; new content stays first.
PROMPIX_VISUAL_CLASSIFY_PUBLISHED=0
# Review limits: integer 0..20 per UTC day; 0 disables new requests.
# Each metadata request: <=3 candidates, <=16,000 serialized input characters.
# Each visual request: <=3 candidates, <=16 images, <=32 MB, <=32,000 input characters.
# PROMPIX_CODEX=/absolute/path/to/codex

# ~/.config/prompix/translation.env
PROMPIX_TRANSLATION_PROVIDER=codex
PROMPIX_TRANSLATION_MODEL=gpt-5.6-luna
PROMPIX_TRANSLATION_MAX_REQUESTS=36
# This USD setting applies only when the translation provider is openai.
# Codex is bounded by request counts/input caps/timeouts/account limits, not USD.
PROMPIX_TRANSLATION_MAX_USD=2

# ~/.config/prompix/x.env — import existing account spend before enabling.
# The same external ledger must be used by every collector and pilot.
PROMPIX_X_MONTHLY_USD=20
# Optional: PROMPIX_X_DAILY_USD (defaults to the monthly ceiling).
# Optional: PROMPIX_X_SPEND_DIR (defaults to ~/.local/share/prompix/x-spend).
# Existing request-count controls remain PROMPIX_X_MAX_REQUESTS,
# PROMPIX_X_MAX_POSTS and PROMPIX_X_AVAILABILITY_MAX_REQUESTS.
# Keep all real credentials outside Git, under ~/.config/prompix, mode 0600.
# Optional: reserve remaining-month maintenance before discovery/acquisition.
# Requires current runtime + a complete authoritative census; default 0.
# PROMPIX_X_MAINTENANCE_RESERVE=1
