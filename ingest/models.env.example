# Copy to ~/.config/prompix/models.env and chmod 600. Values never belong in the repository.
# Only the providers you use need a value; local subscriptions (codex-cli, claude-cli) need none.
KIMI_CODE_API_KEY=
KIMI_CODE_BASE_URL=
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
# Optional: absolute paths when the commands are not on PATH.
PROMPIX_CODEX=
PROMPIX_CLAUDE=
