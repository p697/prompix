    "onboarding.discover.title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让灵感，展开"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓靈感，展開"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unfold your inspiration"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひらく、ひらめき"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영감을 펼쳐보세요"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Despliega tu inspiración"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra espaço à inspiração"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déployez votre inspiration"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfalte deine Inspiration"
          }
        }
      }
    },
    "onboarding.discover.body": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好作品，是下一次创作的开始"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "好作品，是下一次創作的開始"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your next creation starts with a little inspiration."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "素敵な作品から、次の創作がはじまる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "멋진 작품에서 다음 창작이 시작됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una gran obra puede ser el inicio de la tuya."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma bela criação pode inspirar a sua próxima."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une belle création peut inspirer la vôtre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine schöne Idee ist der Anfang deiner nächsten Kreation."
          }
        }
      }
    },
