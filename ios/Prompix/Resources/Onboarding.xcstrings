        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓第一屏，就更懂你"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make your first feed feel like you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初のフィードを、あなたらしく。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 화면부터 나답게."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un inicio más a tu medida."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um início com a sua cara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un premier fil qui vous ressemble."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit dein erster Feed zu dir passt."
          }
        }
      }
