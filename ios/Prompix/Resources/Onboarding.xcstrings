    "onboarding.discover.title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发现值得一试的 Prompt"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "發現值得一試的 Prompt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discover prompts worth trying"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "試してみたいプロンプトに出会う"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "써 보고 싶은 프롬프트를 발견하세요"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descubre prompts que vale la pena probar"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descubra prompts que vale a pena experimentar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Découvrez des prompts à essayer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entdecke Prompts, die du ausprobieren möchtest"
          }
        }
      }
    },
    "onboarding.discover.body": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文字、图像、视频与网页灵感。无需账号，随时开始探索。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文字、圖像、影片與網頁靈感。無需帳號，隨時開始探索。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideas for text, images, video and websites. Explore freely, without an account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文章、画像、動画、ウェブサイトのアイデアを。アカウントなしで、いつでも探せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글, 이미지, 동영상, 웹사이트를 위한 아이디어. 계정 없이 자유롭게 둘러보세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideas para textos, imágenes, vídeos y sitios web. Explora libremente, sin cuenta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideias para textos, imagens, vídeos e sites. Explore à vontade, sem precisar de uma conta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des idées pour vos textes, images, vidéos et sites web. Explorez librement, sans compte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideen für Texte, Bilder, Videos und Websites. Entdecke sie ganz ohne Konto."
          }
        }
      }
    },
    "onboarding.save.title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留住灵感，认识创作者"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "留住靈感，認識創作者"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save ideas. Discover their creators."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイデアを保存。作り手を知る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이디어를 모으고 창작자를 만나세요"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda ideas y descubre a sus creadores"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde ideias e descubra seus criadores"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez vos idées, découvrez leurs créateurs"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewahre Ideen und entdecke ihre Kreativen"
          }
        }
      }
    },
    "onboarding.save.body": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收藏喜欢的 Prompt，也能收藏创作者。保存在本机，方便下次接着看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收藏喜歡的 Prompt，也能收藏創作者。儲存在本機，方便下次接著看。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save your favorite prompts and creators on this device, ready to return to later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "気になるプロンプトや作り手を端末に保存して、いつでも見返せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마음에 드는 프롬프트와 창작자를 이 기기에 저장하고 언제든 다시 찾아보세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda tus prompts y creadores favoritos en este dispositivo para volver a ellos cuando quieras."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve seus prompts e criadores favoritos neste dispositivo para voltar a eles quando quiser."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez vos prompts et créateurs favoris sur cet appareil pour les retrouver plus tard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere deine liebsten Prompts und Kreativen auf diesem Gerät, um sie später wiederzufinden."
          }
        }
      }
    },
    "onboarding.use.title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "带到你的工具中使用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帶到你的工具中使用"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take an idea into your tools"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつものツールで使ってみる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즐겨 쓰는 도구에서 이어 가세요"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva tus ideas a tus herramientas"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leve suas ideias para suas ferramentas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez vos idées dans vos outils"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze Ideen in deinen Tools"
          }
        }
      }
    },
    "onboarding.use.body": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制或编辑 Prompt，在 ChatGPT 等工具中继续。由你确认并发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "複製或編輯 Prompt，在 ChatGPT 等工具中繼續。由你確認並傳送。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy or edit a prompt, then continue in tools like ChatGPT. You review and send it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロンプトをコピー・編集して、ChatGPT などのツールへ。内容を確認してから、自分で送信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프롬프트를 복사하거나 편집한 뒤 ChatGPT 같은 도구에서 이어 가세요. 내용을 확인하고 직접 보내면 됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia o edita un prompt y continúa en herramientas como ChatGPT. Tú lo revisas y lo envías."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie ou edite um prompt e continue em ferramentas como o ChatGPT. Você confere e envia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiez ou modifiez un prompt, puis continuez dans un outil comme ChatGPT. Vous le vérifiez et l’envoyez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiere oder bearbeite einen Prompt und nutze ihn in Tools wie ChatGPT. Du prüfst und sendest ihn selbst."
          }
        }
      }
    },
    "onboarding.use.skills": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Skills 可带到编程助手，按说明安装与使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Skills 可帶到程式助理，依說明安裝與使用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take Skills to your coding assistant and follow their installation and usage instructions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Skills はコーディングアシスタントへ。説明に沿ってインストールし、使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Skills는 코딩 도우미로 가져가 안내에 따라 설치하고 사용할 수 있어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva los Skills a tu asistente de programación y sigue sus instrucciones de instalación y uso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leve os Skills ao seu assistente de programação e siga as instruções de instalação e uso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transférez les Skills à votre assistant de programmation et suivez leurs instructions d’installation et d’utilisation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze Skills in deinem Programmierassistenten und folge der Anleitung zur Installation und Verwendung."
          }
        }
      }
    },
