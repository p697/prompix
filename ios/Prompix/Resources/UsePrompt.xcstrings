    "version.note": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换只影响本次使用，已保存的修改会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換只影響本次使用，已儲存的修改會保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switching only changes what you use now. Your saved edits are kept."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り替えは今回使う内容にのみ適用されます。保存済みの編集は残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전환은 이번에 사용할 내용에만 적용됩니다. 저장한 수정 내용은 유지됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cambio solo afecta a lo que uses ahora. Tus cambios guardados se conservan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A troca só afeta o que você usa agora. Suas edições salvas são mantidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce choix ne change que le contenu utilisé maintenant. Vos modifications enregistrées sont conservées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wechsel gilt nur für diese Verwendung. Gespeicherte Änderungen bleiben erhalten."
          }
        }
      }
    },
