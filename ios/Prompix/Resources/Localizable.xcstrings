    "检查网络后再试。完整 Prompt 仍可复制使用。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your connection and try again. You can still copy the full Prompt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查网络后再试。完整 Prompt 仍可复制使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查網路後再試。完整 Prompt 仍可複製使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続を確認して、もう一度お試しください。Prompt 全文は引き続きコピーできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크 연결을 확인한 후 다시 시도해 주세요. 전체 Prompt는 복사해 사용할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba tu conexión e inténtalo de nuevo. Aún puedes copiar el Prompt completo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique sua conexão e tente novamente. Você ainda pode copiar o Prompt completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez votre connexion et réessayez. Vous pouvez toujours copier le Prompt complet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe deine Verbindung und versuche es erneut. Du kannst den vollständigen Prompt weiterhin kopieren."
          }
        }
      }
    },
