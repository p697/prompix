    "收藏仍然无法读取，原文件与离线预览已保留。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved items still couldn’t be read. The original file and offline previews are preserved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收藏仍然无法读取，原文件与离线预览已保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收藏仍無法讀取，原檔案與離線預覽已保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みの項目をまだ読み込めません。元のファイルとオフラインプレビューは保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 항목을 여전히 읽지 못했습니다. 원본 파일과 오프라인 미리보기는 보존되어 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos guardados siguen sin poder leerse. El archivo original y las vistas previas sin conexión se conservan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não foi possível ler os itens salvos. O arquivo original e as prévias offline foram preservados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments enregistrés ne peuvent toujours pas être lus. Le fichier d’origine et les aperçus hors ligne sont conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte Inhalte konnten weiterhin nicht gelesen werden. Die Originaldatei und Offline-Vorschauen bleiben erhalten."
          }
        }
      }
    },
