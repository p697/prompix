        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "콘텐츠를 불러오지 못했습니다. 저장한 항목은 계속 볼 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar el contenido. Aún puedes ver los elementos guardados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar o conteúdo. Você ainda pode ver os itens salvos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu n’a pas pu être chargé. Vous pouvez toujours consulter vos favoris."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Inhalte konnten nicht geladen werden. Deine gespeicherten Inhalte kannst du weiterhin ansehen."
