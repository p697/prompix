    "此语言暂时无法下载，当前内容已保留。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此语言暂时无法下载，当前内容已保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This language could not be downloaded. Your current content is still available."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此語言暫時無法下載，目前內容已保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この言語をダウンロードできませんでした。現在の内容は引き続き使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 언어를 다운로드하지 못했습니다. 현재 콘텐츠는 그대로 유지됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo descargar este idioma. El contenido actual sigue disponible."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível baixar este idioma. O conteúdo atual continua disponível."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de télécharger cette langue. Le contenu actuel reste disponible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Sprache konnte nicht heruntergeladen werden. Der aktuelle Inhalt bleibt verfügbar."
          }
        }
      }
    },
