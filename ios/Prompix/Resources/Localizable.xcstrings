    "灵感暂时没有加载成功。你仍然可以查看已保存的收藏。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Content couldn’t be loaded. You can still browse saved items."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灵感暂时没有加载成功。你仍然可以查看已保存的收藏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內容未能載入。你仍可查看已儲存的收藏。"
