    "learning.description": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据你看过、点开、收藏和使用的内容，在本机调整推荐。关闭后仍会参考你主动选择的兴趣。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use viewed, opened, saved and used content to adjust recommendations locally. Your selected interests still apply when this is off."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據你看過、點開、收藏和使用的內容，在本機調整推薦。關閉後仍會參考你主動選擇的興趣。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示・閲覧・保存・使用した内容をもとに、端末内でおすすめを調整します。オフでも選択した興味は反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보고 열고 저장하고 사용한 콘텐츠로 기기 안에서 추천을 조정합니다. 꺼도 직접 선택한 관심사는 반영됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta las recomendaciones en el dispositivo según lo que ves, abres, guardas y usas. Tus intereses elegidos siguen activos al desactivarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta as recomendações no dispositivo com base no que você vê, abre, salva e usa. Seus interesses escolhidos continuam ativos ao desativar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adapte les suggestions sur l’appareil selon les contenus vus, ouverts, enregistrés et utilisés. Vos intérêts choisis restent actifs si cette option est désactivée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passt Empfehlungen lokal an angesehene, geöffnete, gespeicherte und genutzte Inhalte an. Deine ausgewählten Interessen gelten auch bei deaktivierter Funktion."
          }
        }
      }
    },
    "reset.title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重置推荐偏好"
          }
        },
        "en": {
