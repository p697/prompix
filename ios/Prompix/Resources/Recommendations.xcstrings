    "preferences.failed": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "偏好暂未保存，请检查设备存储空间；已有文件已保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferences couldn’t be saved. Check device storage; the existing file has been kept."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偏好暫未儲存，請檢查裝置儲存空間；已有檔案已保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を保存できませんでした。空き容量を確認してください。既存のファイルは保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정을 저장하지 못했습니다. 기기 저장 공간을 확인하세요. 기존 파일은 유지됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron guardar las preferencias. Revisa el almacenamiento; el archivo anterior se conserva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar as preferências. Verifique o armazenamento; o arquivo existente foi mantido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer les préférences. Vérifiez le stockage ; le fichier existant a été conservé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einstellungen konnten nicht gespeichert werden. Prüfe den Speicherplatz; die vorhandene Datei bleibt erhalten."
          }
        }
      }
    },
