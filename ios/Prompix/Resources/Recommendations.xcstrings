    "reset.description": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除兴趣选择和本地学习记录，收藏和草稿会保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear interests and local learning history. Saved content and drafts will stay."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除興趣選擇和本機學習記錄，收藏和草稿會保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "興味の選択と端末内の学習履歴を消去します。保存した内容と下書きは残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관심사 선택과 기기 내 학습 기록을 지웁니다. 저장한 콘텐츠와 초안은 유지됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra los intereses y el historial de aprendizaje local. Se conservarán los guardados y borradores."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaga os interesses e o histórico de aprendizado local. O conteúdo salvo e os rascunhos serão mantidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface les intérêts et l’historique d’apprentissage local. Les favoris et brouillons seront conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht Interessen und lokalen Lernverlauf. Gespeicherte Inhalte und Entwürfe bleiben erhalten."
          }
        }
      }
    },
