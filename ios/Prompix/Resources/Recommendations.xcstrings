            "value": "Weniger freizügige Empfehlungen"
          }
        }
      }
    },
    "comfort.description": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "减少泳装、内衣及明显性感的画面；人像和时尚仍可正常推荐。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce swimwear, underwear and overtly suggestive imagery. Portraits and fashion can still be recommended."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "減少泳裝、內衣及明顯性感的畫面；人像和時尚仍可正常推薦。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水着・下着・性的な演出のある画像を減らします。ポートレートやファッションは引き続きおすすめします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수영복, 속옷, 성적 연출이 두드러진 이미지를 줄입니다. 인물과 패션은 계속 추천할 수 있어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce las imágenes de bañadores, ropa interior o poses claramente sugerentes. Los retratos y la moda siguen disponibles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduz imagens de roupas de banho, roupas íntimas ou poses claramente sugestivas. Retratos e moda continuam nas recomendações."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduit les images de maillots, de sous-vêtements ou aux poses suggestives. Les portraits et la mode restent recommandés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduziert Bilder mit Badebekleidung, Unterwäsche oder deutlich anzüglicher Inszenierung. Porträts und Mode werden weiterhin empfohlen."
          }
        }
      }
    }
  },
  "version": "1.0"
}
