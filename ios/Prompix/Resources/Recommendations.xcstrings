    "interests.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建议选三个或更多，也可以先跳过。我们会据此推荐，同时保留一些新鲜发现。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose three or more, or skip for now. We’ll use your choices while leaving room for new discoveries."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建議選三個或更多，也可以先略過。我們會據此推薦，同時保留一些新鮮發現。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3つ以上がおすすめです。今はスキップしても大丈夫。好みに合わせつつ、新しい発見もお届けします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세 개 이상 선택하거나 지금은 건너뛰세요. 취향을 반영하면서 새로운 발견도 추천해 드려요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige tres o más, o sáltalo por ahora. Usaremos tus elecciones y dejaremos espacio para nuevos descubrimientos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha três ou mais, ou pule por enquanto. Usaremos suas escolhas sem deixar de apresentar novas descobertas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez-en trois ou plus, ou passez cette étape. Vos choix guideront les suggestions, tout en gardant une place aux découvertes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle drei oder mehr oder überspringe diesen Schritt. Wir berücksichtigen deine Auswahl und lassen Raum für neue Entdeckungen."
          }
        }
      }
    },
    "interests.private": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "兴趣和浏览偏好只保存在这台设备上。之后可随时在设置中修改。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interests and browsing preferences stay on this device. You can change them in Settings anytime."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "興趣和瀏覽偏好只保存在這台裝置上。之後可隨時在設定中修改。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "興味や閲覧の好みはこのデバイスにのみ保存されます。設定でいつでも変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관심사와 탐색 취향은 이 기기에만 저장됩니다. 설정에서 언제든 바꿀 수 있어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus intereses y preferencias se guardan solo en este dispositivo. Puedes cambiarlos en Ajustes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus interesses e preferências ficam apenas neste dispositivo. Você pode alterá-los nos ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos intérêts et préférences restent sur cet appareil. Vous pouvez les modifier à tout moment dans les réglages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Interessen und Lesevorlieben bleiben auf diesem Gerät. Du kannst sie jederzeit in den Einstellungen ändern."
          }
        }
      }
    },
